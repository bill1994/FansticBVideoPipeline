{
  "name": "remotion-overlay-pipeline",
  "version": "0.2.0",
  "description": "在已粗剪的实拍视频上叠加 motion-graphic overlay 的分阶段管线：强制对齐 → 感知 → storyboard 起草 → 17 项构建期校验 → Remotion 渲染。",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "templates",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pipeline": "tsx src/cli.ts",
    "align": "tsx src/cli.ts align",
    "perceive": "tsx src/cli.ts perceive",
    "storyboard": "tsx src/cli.ts storyboard",
    "validate": "tsx src/cli.ts validate",
    "render": "tsx src/cli.ts render",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "remotion studio src/remotion/index.ts",
    "render:video": "remotion render src/remotion/index.ts Overlay out/video.mp4 --gl=angle"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "onnxruntime-node": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/install-whisper-cpp": "4.0.534",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jimp": "^1.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
