# ── 依赖与构建产物 ─────────────────────────────────────────────
node_modules/
.npm/
out/
dist/
build/
.remotion/
*.tsbuildinfo
.vitest-cache/
vitest.config.ts.timestamp-*.mjs

# ── 逐任务工作区（F1：jobs/<jobId>/00-input → 06-review）──────
# 阶段目录是不可变快照，属逐次运行的产物，不进版本库。
jobs/*
!jobs/.gitkeep

# ── 媒体大文件（如需版本化请走 git-lfs）────────────────────────
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4a
*.aac
*.flac
*.wav
*.mp3
*.srt
*.ass
*.vtt

# ── 环境与本地配置 ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.npmrc.local

# ── 编辑器 / 系统 ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── 日志与临时文件 ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
*.tmp

# ── WorkBuddy 本地会话数据（保留记忆与技能，其余忽略）──────────
.workbuddy/*
!.workbuddy/memory/
!.workbuddy/skills/

# ── 本机状态记忆（各机独立，不跨机同步）────────────────────────
# MEMORY.md   = 跨机共享的项目知识（入库）
# LOCAL.md    = 本机路径/素材/jobs 进度/本机环境坑（不记录）
# 两机共写同一份 MEMORY.md 曾互相覆盖并写出「本机 jobs/ 空」这类假话，
# 故按「共享知识 / 本机事实」拆分。详见 MEMORY.md 的 git 节。
.workbuddy/memory/LOCAL.md
.workbuddy/memory/local*.md

# whisper.cpp 二进制与模型（M-1 第一步，体积大且可重新下载）
# 见 tools/setup-whisper.mts
whisper.cpp/

# perceive 模型（可重新下载，不入库；见报告 §5.4 施工计划）
perceive-models/
